#!/bin/sh
# Runs before every push: the same two checks CI runs, ten seconds earlier.
#
# Enable it once per clone:
#   git config core.hooksPath .githooks
#
# Skip it for a single push with `git push --no-verify`.

set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: tests"
./study test

echo "pre-push: doctor"
./study doctor
