#!/bin/sh
# Entry point. Finds a Python 3.12+ and runs the package in place.
# No install, no virtualenv, no dependencies.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for candidate in "${STUDYKIT_PYTHON:-}" python3 python3.14 python3.13 python3.12 python; do
    [ -n "$candidate" ] || continue
    command -v "$candidate" >/dev/null 2>&1 || continue
    if "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
        PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec "$candidate" -m studykit "$@"
    fi
done

echo "studykit needs Python 3.12 or newer on your PATH." >&2
echo "Found: $(python3 --version 2>&1 || echo 'no python3')" >&2
echo "Set STUDYKIT_PYTHON=/path/to/python3.12 to point at a specific one." >&2
exit 1
